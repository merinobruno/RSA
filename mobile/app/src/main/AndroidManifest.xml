<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location: fine location is required to obtain GPS fixes via FusedLocationProviderClient.
         Background location is required because captures must continue while the screen is off
         and the app is not in the foreground (Android 10+ treats this as a separate grant). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service: required to keep capturing every 30s with the screen off, and to
         declare the "location" foreground service type mandated by Android 14 (API 34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13+ requires runtime consent to show the persistent "tracking active" notification
         that the foreground service depends on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Networking: send queued packets to the backend and check connectivity before attempting it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Best-effort mitigation for aggressive OEM battery managers (see README caveat). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- WorkManager's periodic retry job should survive a reboot mid-flight-day. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:name=".MobileApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RsaTelemetry"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RsaTelemetry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".service.TelemetryForegroundService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- WorkManager registers its own boot-rescheduling receiver and job service via its
             bundled manifest (merged automatically from the work-runtime-ktx dependency); no
             app-level receiver declaration is needed for the periodic retry worker to survive
             a reboot. -->

    </application>

</manifest>
